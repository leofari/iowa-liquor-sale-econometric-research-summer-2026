# Categories to include
selected_categories <- c(
"Cocktail", "Cordial", "Rum", "Gin", "Vodka", "Whisky"
)
# Seasonal sales data ----------------------------------------------------
weekly_sales_by_category <- daily_sales %>%
filter(category_simple %in% selected_categories) %>%
mutate(
category_simple = factor(
category_simple,
levels = selected_categories
),
year = year(date),
week = week(date)
) %>%
group_by(year, week, category_simple) %>%
summarise(
week_category_sale_sum = sum(total_sale_day, na.rm = TRUE),
.groups = "drop"
)
# Seasonal sales plot ----------------------------------------------------
seasonal_plot <- weekly_sales_by_category %>%
group_by(category_simple) %>%
mutate(
category_avg_sales = mean(week_category_sale_sum, na.rm = TRUE),
pct_from_avg = (week_category_sale_sum - category_avg_sales) /
category_avg_sales
) %>%
group_by(category_simple, week) %>%
summarize(
median_pct = median(pct_from_avg, na.rm = TRUE),
q25_pct = quantile(pct_from_avg, 0.25, na.rm = TRUE),
q75_pct = quantile(pct_from_avg, 0.75, na.rm = TRUE),
.groups = "drop"
) %>%
ggplot(aes(x = week)) +
geom_ribbon(
aes(ymin = q25_pct, ymax = q75_pct),
alpha = 0.3,
fill = "gray55"
) +
geom_line(
aes(y = median_pct),
linewidth = 0.9,
color = "black"
) +
geom_hline(
yintercept = 0,
linewidth = 0.3,
color = "gray35"
) +
scale_x_continuous(
breaks = seq(from = 0, to = 52, by = 8),
expand = c(0.01, 0.01)
) +
scale_y_continuous(
labels = scales::label_percent(accuracy = 1),
breaks = seq(-1, 1, by = 0.5)
) +
facet_wrap(
~category_simple,
ncol = 1,
axes = "all_x",
axis.labels = "all_x"
) +
labs(
title = "Seasonal Sales Deviations",
subtitle = "Median weekly deviation from category average",
x = "Week of year",
y = "Percent above/below average"
) +
theme_linedraw(base_size = 12) +
theme(
plot.title = element_text(
face = "bold",
size = 22,
hjust = 0.5,
color = "black",
margin = margin(b = 4)
),
plot.subtitle = element_text(
face = "italic",
size = 13,
hjust = 0.5,
color = "gray10",
margin = margin(b = 12)
),
axis.title.x = element_text(
size = 13,
color = "black",
margin = margin(t = 8)
),
axis.title.y = element_text(
size = 13,
color = "black",
margin = margin(r = 8)
),
axis.text = element_text(
size = 9,
color = "gray10"
),
strip.background = element_rect(
fill = "black",
color = "black",
linewidth = 0.4
),
strip.text = element_text(
size = 10,
color = "white",
face = "plain",
margin = margin(t = 3, b = 3)
),
panel.grid.major = element_line(
color = "gray82",
linewidth = 0.25
),
panel.grid.minor = element_line(
color = "gray92",
linewidth = 0.15
),
panel.spacing.y = unit(1.1, "lines"),
plot.margin = margin(12, 12, 12, 12)
)
# Discount timing plot ---------------------------------------------------
discount_plot <- discounts %>%
